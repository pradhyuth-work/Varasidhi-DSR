# ---------------------------------------------------------------------------
# Supabase connection strings (copy from: Supabase Dashboard > Project Settings
# > Database > Connection string). Do NOT commit the real .env file.
# ---------------------------------------------------------------------------

# App runtime connection — use the "Transaction" pooler (port 6543).
# Recommended for Vercel serverless. Example shape:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct connection (port 5432) — used only for schema creation & data migration
# (DDL + bulk load). Example shape:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Admin password gate for the app (replaces the old hardcoded default).
ADMIN_PASSWORD=

# Local dev only: port for `npm run dev` (Vercel sets this automatically in prod).
PORT=3000
